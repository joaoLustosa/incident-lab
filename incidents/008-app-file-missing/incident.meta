ID="008"

TITLE="Missing Application File"

CATEGORY="application"

DIFFICULTY="Medium"

TICKET="Users report the application became unavailable after a deployment."

ROOT_CAUSE="The FastAPI application entry point is missing."

EXPECTED_FINDINGS="
- fastapi service repeatedly restarting
- nginx service active
- localhost returns 502 Bad Gateway
- main.py missing from /opt/incident-lab/app
- journal reports 'Could not import module \"main\"'
"

EXPECTED_COMMANDS="
- systemctl status fastapi
- journalctl -u fastapi -n 20
- ls -l /opt/incident-lab/app
- curl http://localhost
"

ID="009"
TITLE="Incorrect Application File Permissions"
CATEGORY="filesystem"
DIFFICULTY="Medium"

TICKET="Users report the application became unavailable after recent maintenance."

ROOT_CAUSE="The FastAPI application file is owned by the wrong user."

EXPECTED_FINDINGS="
- fastapi service repeatedly restarting
- nginx service active
- localhost returns 502 Bad Gateway
- main.py owned by root:root
- journal reports permission denied
"

EXPECTED_COMMANDS="
- systemctl status fastapi
- journalctl -u fastapi -n 20
- ls -l /opt/incident-lab/app/main.py
- stat /opt/incident-lab/app/main.py
- curl http://localhost
"

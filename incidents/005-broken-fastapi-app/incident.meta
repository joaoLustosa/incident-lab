ID="005"
TITLE="Broken FastAPI Application"
CATEGORY="application"
DIFFICULTY="Medium"

TICKET="Users report 502 Bad Gateway responses after a recent application update."

ROOT_CAUSE="The deployed FastAPI application contains a Python syntax error."

EXPECTED_FINDINGS="
- fastapi service repeatedly restarting
- fastapi service exits with a Python SyntaxError
- nginx service active
- localhost returns 502 Bad Gateway
"

EXPECTED_COMMANDS="
- systemctl status fastapi
- journalctl -u fastapi
- systemctl is-active fastapi
- curl http://localhost
"

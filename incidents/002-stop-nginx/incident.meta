ID="002"
TITLE="Nginx Service Stopped"
DIFFICULTY="Easy"

TICKET="Users report the website is unavailable."

ROOT_CAUSE="Nginx service is stopped."

EXPECTED_FINDINGS="
- nginx service inactive
- fastapi service active
- localhost connection fails
- port 80 is not listening
"

EXPECTED_COMMANDS="
- systemctl status nginx
- systemctl is-active nginx
- journalctl -u nginx
- curl http://localhost
- ss -tlnp
"

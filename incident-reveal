#!/bin/bash

STATE_FILE="incident-state/current-incident"

if [ ! -f "$STATE_FILE" ]; then
    echo "No active incident."
    exit 1
fi

INCIDENT_NAME=$(cat "$STATE_FILE")

META_FILE="incidents/${INCIDENT_NAME}/incident.meta"

if ! source "$META_FILE"; then
    echo "ERROR: Metadata loading failed."
    exit 1
fi

echo "INCIDENT REVIEW"
echo
echo "ID: $ID"
echo "TITLE: $TITLE"
echo "ROOT CAUSE: $ROOT_CAUSE"

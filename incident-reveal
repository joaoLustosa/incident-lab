#!/bin/bash

LAB_ROOT="/opt/incident-lab"

STATE_FILE="$LAB_ROOT/incident-state/current-incident"

if [ ! -f "$STATE_FILE" ]; then
    echo "No active incident."
    exit 1
fi

INCIDENT_NAME=$(cat "$STATE_FILE")

META_FILE="$LAB_ROOT/incidents/${INCIDENT_NAME}/incident.meta"

if ! source "$META_FILE"; then
    echo "ERROR: Metadata loading failed."
    exit 1
fi

echo "INCIDENT REVIEW"
echo
echo "TITLE: $TITLE"
echo "DIFFICULTY: $DIFFICULTY"
echo "ROOT CAUSE: $ROOT_CAUSE"
echo "EXPECTED FINDINGS: $EXPECTED_FINDINGS"
echo "EXPECTED COMMANDS: $EXPECTED_COMMANDS"

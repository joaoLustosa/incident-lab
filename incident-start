#!/bin/bash

STATE_FILE="incident-state/current-incident"

if [ -f "$STATE_FILE" ]; then
    echo "ERROR: Active incident detected."
    echo
    echo "Run incident-reveal before starting a new incident."
    exit 1
fi

INCIDENT_NAME="001-stop-fastapi"

echo "$INCIDENT_NAME" > "$STATE_FILE"

META_FILE="incidents/${INCIDENT_NAME}.meta"

source "$META_FILE"

echo "Incident created."
echo
echo "TICKET: $TICKET"

#!/bin/bash

STATE_FILE="incident-state/current-incident"

if [ -f "$STATE_FILE" ]; then
    echo "ERROR: Active incident detected."
    echo
    echo "Run incident-reset before starting a new incident."
    exit 1
fi

INCIDENT_NAME="003-bad-upstream"
SCRIPT_FILE="incidents/${INCIDENT_NAME}/incident.sh"
META_FILE="incidents/${INCIDENT_NAME}/incident.meta"

if [ ! -f "$SCRIPT_FILE" ]; then
    echo "ERROR: Incident script not found."
    exit 1
fi

if [ ! -f "$META_FILE" ]; then
    echo "ERROR: Incident metadata not found."
    exit 1
fi

if ! bash "$SCRIPT_FILE"; then
    echo "ERROR: Incident injection failed."
    exit 1
fi

if ! source "$META_FILE"; then
    echo "ERROR: Metadata loading failed."
    exit 1
fi

echo "$INCIDENT_NAME" > "$STATE_FILE"

echo "Incident created."
echo
echo "TICKET: $TICKET"

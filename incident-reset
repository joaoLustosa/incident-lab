#!/bin/bash

if [ "$EUID" -ne 0 ]; then
    echo "ERROR: Run as root."
    exit 1
fi

STATE_FILE="incident-state/current-incident"

echo "Restoring application files..."

cp assets/app/main.py \
   /opt/incident-lab/app/main.py

chown incident-lab:incident-lab \
   /opt/incident-lab/app/main.py

echo "Restoring systemd service..."

cp assets/systemd/fastapi.service \
   /etc/systemd/system/fastapi.service

systemctl daemon-reload

echo "Restoring Nginx configuration..."

cp assets/nginx/incident-lab.conf \
   /etc/nginx/sites-available/incident-lab.conf

rm -f /etc/nginx/sites-enabled/incident-lab.conf

ln -sf \
   /etc/nginx/sites-available/incident-lab.conf \
   /etc/nginx/sites-enabled/incident-lab.conf

if ! nginx -t; then
    echo "ERROR: Nginx configuration validation failed."
    exit 1
fi

echo "Restarting services..."

systemctl reset-failed nginx
systemctl reset-failed fastapi

if ! systemctl restart nginx; then
    echo "ERROR: Nginx service start failed."
    exit 1
fi

if ! systemctl restart fastapi; then
    echo "ERROR: FastAPI service start failed."
    exit 1
fi

echo "Verifying system health..."

sleep 2

if ! ./healthcheck.sh; then
    echo
    echo "ERROR: Environment reset failed."
    echo
    echo "Manual intervention required."
    exit 1
fi

rm -f "$STATE_FILE"

echo
echo "Environment restored successfully."
